{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command",
          "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/commit-gate.sh",
          "timeout": 300,
          "onFailure": "block" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [ { "type": "command",
          "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/svelte-check.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command",
          "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/done-gate.sh",
          "timeout": 300 } ] }
    ],
    "InstructionsLoaded": [
      { "hooks": [ { "type": "command",
          "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/log-instructions.sh" } ] }
    ]
  }
}
