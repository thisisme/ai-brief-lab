{
  "name": "ai-brief-lab",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore --watch",
    "elements:build": "vite build -c vite.elements.config.js",
    "elements:serve": "php -S 127.0.0.1:8099 -t hosts/php/public",
    "elements:smoke": "node scripts/elements-smoke.mjs http://127.0.0.1:8099/ stock-badge lab-counter",
    "models": "node scripts/models.mjs",
    "agents:effort": "node scripts/models.mjs --lint",
    "gate": "bash scripts/gate.sh",
    "doctor": "node scripts/claude-doctor.mjs",
    "telemetry:sink": "node scripts/otel-sink.mjs",
    "telemetry:report": "node scripts/pilot-report.mjs",
    "telemetry:test": "node scripts/telemetry-test.mjs",
    "guard:test": "node scripts/prompt-guard-test.mjs",
    "form:smoke": "node scripts/form-smoke.mjs http://127.0.0.1:8099/order.php",
    "trace:sink": "node scripts/trace-sink.mjs",
    "trace:tree": "node scripts/trace-sink.mjs --tree",
    "trace:test": "node scripts/trace-test.mjs",
    "headless:probe": "node scripts/headless-probe.mjs",
    "stepper:smoke": "node scripts/stepper-smoke.mjs",
    "profile:test": "node scripts/profile-test.mjs",
    "profile": "node --env-file-if-exists=.env.local scripts/user-profile.mjs",
    "guardrail:report": "node scripts/guardrail-report.mjs",
    "guardrail:test": "node scripts/guardrail-test.mjs",
    "skills:lint": "node scripts/skills-lint.mjs",
    "skills:test": "node scripts/skills-lint-test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/mcp": "^0.1.26",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0"
  }
}
